# Copy this file to .env for local development. Do not add secrets here.
#
# Docker Compose will map the service-scoped failure values below to each
# process's generic FAILURE_* variables when Compose is added (M5-05–M5-07).

# Shared Gateway/Cloud protocol defaults
# Allowed: classical, mlkem. Use mlkem only with PQC_FAILURE_POLICY=fail_closed.
SECURITY_MODE=classical
# Frozen protocol v1 value: 300 only.
SESSION_TTL_SECONDS=300

# Legacy Device
# Any non-empty device identifier.
DEVICE_ID=sensor-001
# Absolute HTTP(S) URL, for example http://edge-gateway:8000.
GATEWAY_URL=http://edge-gateway:8000
# Positive integer number of seconds (1 or greater).
SEND_INTERVAL_SECONDS=5
# Positive integer number of seconds (1 or greater).
REQUEST_TIMEOUT_SECONDS=3
# Non-negative integer; 0 disables Legacy retries.
MAX_RETRIES=2

# Allowed: none, invalid_temperature, invalid_humidity, missing_field,
# invalid_timestamp, duplicate_sequence, out_of_order_sequence, random.
LEGACY_FAILURE_MODE=none
# Finite number from 0.0 through 1.0 inclusive.
LEGACY_FAILURE_RATE=0.0
# Integer, or leave empty to disable deterministic Legacy fault selection.
LEGACY_FAILURE_SEED=1

# Edge Gateway
# Any non-empty Gateway identifier.
GATEWAY_ID=gateway-001
# Absolute HTTP(S) URL, for example http://cloud-service:9000.
CLOUD_URL=http://cloud-service:9000
# Finite number of seconds greater than 0.
CLOUD_TIMEOUT_SECONDS=3
# Non-negative integer; 0 disables Gateway Cloud retries.
CLOUD_MAX_RETRIES=2
# Frozen policy value: fail_closed only; plaintext fallback is not supported.
PQC_FAILURE_POLICY=fail_closed

# Allowed: none, processing_error, processing_delay, cloud_timeout,
# cloud_unavailable, drop_message, random, mlkem_handshake_failure,
# corrupt_ciphertext, session_missing, session_expired.
GATEWAY_FAILURE_MODE=none
# Finite number from 0.0 through 1.0 inclusive.
GATEWAY_FAILURE_RATE=0.0
# Any non-empty text, or leave empty to disable deterministic Gateway faults.
GATEWAY_FAILURE_SEED=2
# Finite number of seconds from 0 through 30.
GATEWAY_FAILURE_DELAY_SECONDS=2

# Cloud Service
# Any non-empty Cloud identifier.
CLOUD_ID=cloud-001
# sqlite:/// followed by a database file path, or sqlite:///:memory:.
# Absolute SQLite path inside the Cloud container.
DATABASE_URL=sqlite:////data/cloud.db

# Optional loopback host port used by Compose for Gateway.
GATEWAY_HOST_PORT=8000
# Optional loopback host port used by Compose for Cloud.
CLOUD_HOST_PORT=9000

# Allowed: none, public_key_unavailable, mlkem_decapsulation_failure,
# session_not_found, session_expired, decryption_failure, storage_failure,
# processing_delay, service_unavailable, drop_response, random.
CLOUD_FAILURE_MODE=none
# Finite number from 0.0 through 1.0 inclusive.
CLOUD_FAILURE_RATE=0.0
# Integer, or leave empty to disable deterministic Cloud fault selection.
CLOUD_FAILURE_SEED=3
# Finite number of seconds greater than or equal to 0.
CLOUD_FAILURE_DELAY_SECONDS=2

# Shared non-secret default
# Allowed: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
